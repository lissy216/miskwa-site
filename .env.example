# Resend API key — same key the other sites use. Set in Vercel:
# Project Settings > Environment Variables (Production + Preview).
RESEND_API_KEY=

# Where contact-form messages are delivered. Defaults to miskwa@miskwakimiwan.com.
INQUIRY_EMAIL_TO=

# Sender identity. Must be on a domain verified in Resend.
INQUIRY_EMAIL_FROM=
